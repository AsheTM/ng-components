{
  "name": "@ashetm/ng-components",
  "version": "2.0.0",
  "contributors": [
    {
      "email": "contact@ashetm.com",
      "name": "DAWOUD Haitham",
      "url": "http://ashetm.com"
    }
  ],
  "author": {
    "email": "contact@ashetm.com",
    "name": "DAWOUD Haitham",
    "url": "http://ashetm.com"
  },
  "private": true,
  "engines": {
    "node": "^14.15.0 || ^16.10.0"
  },
  "scripts": {
    "build": "npm run build:ng-dialog && npm run build:ng-input && npm run build:ng-components-demo",
    "build:ng-dialog": "ng build ng-dialog",
    "build:ng-input": "ng build ng-input",
    "build:ng-components-demo": "ng build ng-components-demo",
    "lint": "ng lint",
    "lint:ng-dialog": "ng lint ng-dialog --format stylish",
    "lint:ng-dialog:fix": "npm run lint:ng-dialog -- --fix",
    "lint:ng-input": "ng lint ng-input --format stylish",
    "lint:ng-input:fix": "npm run lint:ng-input -- --fix",
    "lint:ng-components-demo": "ng lint ng-components-demo --format stylish",
    "lint:ng-components-demo:fix": "npm run lint:ng-components-demo -- --fix",
    "package:ng-dialog": "npm run lint:ng-dialog && npm run test:ng-dialog && npm run build:ng-dialog && cd ./dist/ng-dialog && npm pack",
    "package:ng-input": "npm run lint:ng-input && npm run test:ng-input && npm run build:ng-input && cd ./dist/ng-input && npm pack",
    "publish:ng-dialog": "cd ./dist/ng-dialog && npm publish --access=public",
    "publish:ng-input": "cd ./dist/ng-input && npm publish --access=public",
    "start:ng-components-demo": "npm run build:ng-dialog && npm run build:ng-input && ng serve ng-components-demo --open",
    "test": "npm run test:ng-dialog && npm run test:ng-input",
    "test:ng-dialog": "ng test ng-dialog --browsers ChromeHeadlessCI --watch false",
    "test:ng-input": "ng test ng-input --browsers ChromeHeadlessCI --watch false",
    "test:ng-components-demo": "ng test ng-components-demo --browsers ChromeHeadlessCI --watch false",
    "verify": "npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@angular/animations": "~14.2.0",
    "@angular/cdk": "^14.2.7",
    "@angular/common": "~14.2.0",
    "@angular/compiler": "~14.2.0",
    "@angular/core": "~14.2.0",
    "@angular/forms": "~14.2.0",
    "@angular/platform-browser": "~14.2.0",
    "@angular/platform-browser-dynamic": "^14.2.12",
    "@angular/router": "~14.2.0",
    "@ashetm/ng-utility": "^14.0.0",
    "rxjs": "~6.6.0",
    "tslib": "^2.0.0",
    "zone.js": "~0.11.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^14.2.10",
    "@angular-eslint/builder": "14.4.0",
    "@angular-eslint/eslint-plugin": "14.4.0",
    "@angular-eslint/eslint-plugin-template": "14.4.0",
    "@angular-eslint/schematics": "14.4.0",
    "@angular-eslint/template-parser": "14.4.0",
    "@angular/cli": "^14.2.10",
    "@angular/compiler-cli": "^14.2.12",
    "@types/jasmine": "~3.6.0",
    "@types/node": "^16.18.126",
    "@typescript-eslint/eslint-plugin": "5.43.0",
    "@typescript-eslint/parser": "5.43.0",
    "eslint": "^8.28.0",
    "jasmine-core": "~3.8.0",
    "karma": "~6.4.1",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.0.3",
    "karma-jasmine": "~4.0.0",
    "karma-jasmine-html-reporter": "^1.7.0",
    "ng-packagr": "^14.2.2",
    "typescript": "~4.6.4"
  }
}
